# Slack App credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # Required for Socket Mode

# The Slack channel ID to monitor (e.g. C0123456789)
SLACK_WATCH_CHANNEL_ID=C0123456789

# Jira credentials
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Jira field update config
# The field name/ID on the Jira issue to update when a Slack reply is detected
JIRA_FIELD_ID=customfield_10000
# The value to set on the field (for select/option fields this is the option name)
JIRA_FIELD_VALUE=In Review
