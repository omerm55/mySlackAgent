# Slack App credentials (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # Required for Socket Mode

# Jira credentials (API token from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# OAuth 2.0 impersonation — optional. When set, Jira changes appear as the
# triggering Slack user rather than the service account above.
# Register your app at https://developer.atlassian.com → OAuth 2.0 (3LO).
# For local development, expose port 3000 with ngrok and paste the https URL below.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-ngrok-url.ngrok.io/oauth/callback
OAUTH_PORT=3000

# Cloud deployment: used when config/settings.json is absent (e.g. Render)
OPS_CHANNEL_ID=

# Cloud deployment: paste config/integrations.json contents as a single JSON string
INTEGRATIONS_JSON=

# LLM for interpreting free-text DM replies — set ONE of these (priority: OpenAI > Gemini > Anthropic).
# OpenAI (standard): set model via OPENAI_MODEL (default: gpt-4o)
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI (Azure AI Foundry): set base URL and deployment name; api-key header used automatically
OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
OPENAI_DEPLOYMENT=gpt-5.1
# Gemini: get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Anthropic: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Workflow configuration lives in config/integrations.json (local dev) or INTEGRATIONS_JSON (cloud).

# Supabase — persistent store for OAuth tokens, triggers and Jira triggers
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Comma-separated Slack user IDs allowed to create global (everyone) triggers
ADMIN_SLACK_USER_IDS=
# Poller tick in seconds — the floor for each Jira trigger's own "check every N minutes" setting
JIRA_POLL_INTERVAL_SEC=60
# Optional override for "the release currently in progress" when suggesting an epic's Fix Version
# (otherwise derived from the release_calendar table or Jira version dates)
CURRENT_RELEASE_VERSION=
# Max people one Jira trigger may DM per run (the rest follow on the next run)
JIRA_MAX_PROMPTS_PER_RUN=10

# Keep-alive self-ping (prevents Render free tier from sleeping). On Render the URL is
# derived from RENDER_EXTERNAL_URL automatically; set KEEP_ALIVE_URL to override,
# KEEP_ALIVE_INTERVAL_SEC to change cadence (default 300), KEEP_ALIVE_DISABLED=true to turn off.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_SEC=300

# Risk review ask type (R&D Initiative Notifier loop) — PR project field ids; defaults match Sisense.
# Override only if the fields are renumbered. See docs/PROJECT_SPEC.md §2.9.
PR_LATEST_NOTIFICATION_FIELD=customfield_15525
PR_NOTES_FIELD=customfield_12958
PR_TARGET_FIELD=customfield_11818
PR_DEV_OWNER_FIELD=customfield_11962
PR_PM_OWNER_FIELD=customfield_11909
